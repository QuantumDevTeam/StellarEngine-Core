<Project>
    <!--
        Single source of truth for the versions of everything that lives in engine-core.
        Ships inside Stellar.Sdk, so consumers and tooling agree on the exact component set.
        Versions are intentional: bump them by hand, never automatically (Docs/Engine/Versioning.md). A new
        StellarOrchesterVersion on master is what makes a release: .github/workflows/release.yml tags it.
    -->
    <PropertyGroup>
        <!-- The whole Stellar Software Kit release -->
        <StellarOrchesterVersion>0.11.0</StellarOrchesterVersion>

        <!-- Components of this repository -->
        <StellarKernelVersion>0.10.1</StellarKernelVersion>
        <StellarCoreVersion>0.10.0</StellarCoreVersion>
        <StellarRuntimeVersion>0.10.1</StellarRuntimeVersion>
        <StellarToolsVersion>0.3.3</StellarToolsVersion>
        <StellarSdkVersion>0.4.2</StellarSdkVersion>
        <StellarCliVersion>0.2.4</StellarCliVersion>

        <!-- Default version of the engine modules (Stellar.Engine and High-Level Modules) -->
        <StellarEngineVersion>0.11.0</StellarEngineVersion>

        <!-- Native C ABI version: bump on every incompatible change of the exported surface -->
        <StellarNativeAbiVersion>3</StellarNativeAbiVersion>
    </PropertyGroup>

    <!--
        Where the core is published: its GitHub Pages. One place: the JSON schemas that files of modules and projects
        point at ($schema), the installer and the bundle of its documentation all hang off this address.
        A file never names a path of a machine.
    -->
    <PropertyGroup>
        <StellarSiteUri>https://quantumdevteam.github.io/StellarEngine-Core/</StellarSiteUri>
        <StellarSchemasUri>$(StellarSiteUri)schemas/</StellarSchemasUri>
        <!-- GitHub Pages of the mirror: the bundle of the whole engine (scripts/prometheus.ps1) -->
        <StellarEngineSiteUri>https://quantumdevteam.github.io/StellarEngine-Mono/</StellarEngineSiteUri>
    </PropertyGroup>

    <!--
        Where the documentation is read: the docs site, which takes the bundle each repository publishes to its
        GitHub Pages (the addresses above). A page of a project is <StellarDocsUri><project>/<page>. Markdown never
        names this address: it links to other pages by relative paths (Docs/Engine/Documentation.md).
    -->
    <PropertyGroup>
        <StellarDocsUri>https://notagood.org/docs/</StellarDocsUri>
        <StellarDocsProject>stellar-core</StellarDocsProject>
        <StellarEngineDocsProject>stellar-engine</StellarEngineDocsProject>
    </PropertyGroup>
</Project>
